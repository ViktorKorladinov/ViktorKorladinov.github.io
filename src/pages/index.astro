---
import Layout from '../layouts/Layout.astro';
import TalkCard from '../components/TalkCard.astro';
import {getTalks} from '../utils/processTalks'

const {pastTalks, upcomingTalks} = await getTalks()
---

<Layout title="Scheduling Seminar">
    <!-- Hero Section with Gantt Chart Pattern Background -->
    <div class="relative overflow-hidden">
        <!-- Subtle Gantt Chart Pattern Background -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div class="absolute top-0 left-0 w-full h-full"
                 style="background-image: linear-gradient(90deg, #3b82f6 2px, transparent 2px), linear-gradient(180deg, #3b82f6 2px, transparent 2px); background-size: 50px 30px;"></div>
            <!-- Gantt bars - more pronounced -->
            <div class="absolute top-20 left-10 w-48 h-10 bg-blue-500 opacity-50 rounded shadow-sm"></div>
            <div class="absolute top-36 left-32 w-64 h-10 bg-blue-600 opacity-50 rounded shadow-sm"></div>
            <div class="absolute top-52 left-20 w-56 h-10 bg-blue-700 opacity-50 rounded shadow-sm"></div>
            <div class="absolute top-68 right-32 w-48 h-10 bg-blue-500 opacity-50 rounded shadow-sm"></div>
            <div class="absolute top-32 right-20 w-40 h-10 bg-blue-400 opacity-50 rounded shadow-sm"></div>
            <div class="absolute top-48 left-48 w-52 h-10 bg-blue-600 opacity-50 rounded shadow-sm"></div>
        </div>

        <!-- Hero Content -->
        <div class="relative max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-20">
            <div class="text-center mb-12">
                <div class="inline-flex items-center gap-3 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full shadow-sm mb-6">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span class="text-sm font-medium text-gray-700">Virtual Seminar Series</span>
                </div>

                <h1 class="text-5xl lg:text-6xl font-bold mb-6 text-blue-600 ">
                    Scheduling Seminar
                </h1>

                <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed mb-8">
                    Discussing the field's newest advancements and surveying traditional areas in scheduling research
                    and applications.
                    <span class="block mt-2 font-medium text-gray-700">Seminars every second Wednesday across three time zones.</span>
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-wrap justify-center gap-4 mb-8">
                    <a href="#upcoming"
                       class="px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl font-medium shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                        View Schedule
                    </a>
                    <a href="#Calendar"
                       class="px-6 py-3 bg-white text-blue-700 rounded-xl font-medium shadow-lg hover:shadow-xl hover:scale-105 transition-all border-2 border-blue-100">
                        Add to Calendar
                    </a>
                </div>

                <!-- Quick Links -->
                <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto">
                    <a href="#PC_co-chairs"
                       class="px-4 py-2 bg-white/70 backdrop-blur-sm text-center text-sm font-medium text-gray-700 rounded-lg hover:bg-white hover:shadow-md transition-all">
                        PC co-chairs
                    </a>
                    <a href="#Program_committee"
                       class="px-4 py-2 bg-white/70 backdrop-blur-sm text-center text-sm font-medium text-gray-700 rounded-lg hover:bg-white hover:shadow-md transition-all">
                        Program committee
                    </a>
                    <a href="#Calendar"
                       class="px-4 py-2 bg-white/70 backdrop-blur-sm text-center text-sm font-medium text-gray-700 rounded-lg hover:bg-white hover:shadow-md transition-all">
                        Calendar
                    </a>
                    <a href="#Feedback"
                       class="px-4 py-2 bg-white/70 backdrop-blur-sm text-center text-sm font-medium text-gray-700 rounded-lg hover:bg-white hover:shadow-md transition-all">
                        Feedback
                    </a>
                    <a href="https://docs.google.com/spreadsheets/d/1Glyd6FGzoKtZGfClNA_XaIK8vJZtnu8K4OdNcPr_yHc/edit#gid=0"
                       target="_blank"
                       class="px-4 py-2 bg-white/70 backdrop-blur-sm text-center text-sm font-medium text-gray-700 rounded-lg hover:bg-white hover:shadow-md transition-all">
                        Speaker List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Social Links -->
    <div class="max-w-7xl mx-auto px-6 lg:px-8 -mt-8 mb-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="https://www.youtube.com/channel/UCUoCNnaAfw5NAntItILFn4A/live"
               class="group relative bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-red-500 to-red-600 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                <div class="w-10 h-10 mx-auto mb-3 bg-gradient-to-br from-red-500 to-red-600 text-white flex items-center justify-center rounded-lg group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-700 text-center">Join us on YouTube</p>
            </a>

            <a href="https://list.iid.ciirc.cvut.cz/mailman3/lists/schedulingseminar.rtime.felk.cvut.cz/"
               class="group relative bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-blue-600 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                <div class="w-10 h-10 mx-auto mb-3 bg-gradient-to-br from-blue-500 to-blue-600 text-white flex items-center justify-center rounded-lg group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-700 text-center">Subscribe to mailing list</p>
            </a>

            <a href="https://www.linkedin.com/groups/9047074/"
               class="group relative bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-600 to-blue-700 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                <div class="w-10 h-10 mx-auto mb-3 bg-gradient-to-br from-blue-600 to-blue-700 text-white flex items-center justify-center rounded-lg group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-700 text-center">LinkedIn group</p>
            </a>

            <a href="https://twitter.com/ZHanzalek"
               class="group relative bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-sky-400 to-sky-500 opacity-0 group-hover:opacity-10 transition-opacity"></div>
                <div class="w-10 h-10 mx-auto mb-3 bg-gradient-to-br from-sky-400 to-sky-500 text-white flex items-center justify-center rounded-lg group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                    </svg>
                </div>
                <p class="text-sm font-medium text-gray-700 text-center">Follow on Twitter</p>
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 lg:px-8 pb-20">
        <div class="grid lg:grid-cols-2 gap-8">
            <!-- Upcoming Talks -->
            <div id="upcoming">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-1 h-8 bg-gradient-to-b from-blue-600 to-blue-400 rounded-full"></div>
                    <h2 class="text-3xl font-bold text-gray-800">Upcoming Talks</h2>
                    {upcomingTalks.length > 0 && (
                            <div class="px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full animate-pulse">
                                LIVE
                            </div>
                    )}
                </div>

                <div class="space-y-6">
                    {upcomingTalks.map(talk => (
                            <TalkCard talk={talk} past={false}/>
                    ))}
                </div>
            </div>

            <!-- Past Talks -->
            <div>
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-1 h-8 bg-gradient-to-b from-gray-600 to-gray-400 rounded-full"></div>
                    <h2 class="text-3xl font-bold text-gray-800">Past Talks</h2>
                    <div class="px-3 py-1 bg-gray-100 text-gray-600 text-sm font-medium rounded-full">{pastTalks.length}</div>
                </div>

                {pastTalks.length > 0 && (
                        <>
                            <!-- Compact list of remaining talks in scrollable container -->
                            <div class="mt-6 p-5 max-h-[800px] overflow-y-auto space-y-3 pr-2 snap-y snap-mandatory
                            scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100 scroll-pt-4">
                                {pastTalks.toSorted((a, b) => b.id - a.id).map(talk => (
                                        <div class="snap-start"> <!-- Add this wrapper -->
                                            <TalkCard talk={talk} past={true} compact={true}/>
                                        </div>
                                ))}
                            </div>
                            <div class="mt-4 text-center text-sm text-gray-500"> Scroll for all {pastTalks.length}
                                talks
                            </div>
                        </>
                )}
            </div>
        </div>

        <!-- Calendar Section -->
        <section id="Calendar" class="mt-20">
            <div class="flex items-center gap-3 mb-6">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <h2 class="text-3xl font-bold text-gray-800">Calendar</h2>
                <span class="text-sm text-gray-500">(time zone conversion)</span>
            </div>
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
                <iframe
                        src="https://calendar.google.com/calendar/embed?height=600&wkst=2&bgcolor=%234285F4&ctz=Europe%2FPrague&src=..."
                        class="w-full h-[600px] border-0"
                ></iframe>
            </div>
        </section>

        <!-- Feedback Section -->
        <section id="Feedback" class="mt-20">
            <div class="flex items-center gap-3 mb-6">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <h2 class="text-3xl font-bold text-gray-800">Feedback Form</h2>
            </div>
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
                <iframe
                        src="https://docs.google.com/forms/d/e/1FAIpQLSfRk8Nv2J7RvGk-z7Gl5KLWMO5hoZC1Sd-ZFDvgzI97mZe6nw/viewform?embedded=true"
                        class="w-full h-[800px] border-0"
                ></iframe>
            </div>
        </section>
    </div>

    <style>
        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }

        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        /* Custom scrollbar styles */
        .scrollbar-thin::-webkit-scrollbar {
            width: 8px;
        }

        .scrollbar-thin::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</Layout>